{"timestamp":"2026-09-25 11:38:40","tool":"Bash","input":{"command":"cd \"/c/Users/MartinStark/Documents/GitHub/PLS/LM_Studio_Loop_Breaker\" \u0026\u0026 python3 \u003c\u003c \u0027EOF\u0027\nimport ast, re, keyword\nimport z3 as _z3\nfrom typing import Dict, Sequence\n\n_Z3_GLOBALS = {name: getattr(_z3, name) for name in dir(_z3) if not name.startswith(\"_\")}\n_Z3_RESERVED_NAMES = set(_Z3_GLOBALS) | {\"And\",\"Or\",\"Not\",\"If\",\"True\",\"False\"}\n\ndef _extract_symbol_names(expression):\n    names = set(re.findall(r\"\\b[a-zA-Z_][a-zA-Z0-9_]*\\b\", expression))\n    return sorted(name for name in names if name not in _Z3_RESERVED_NAMES and not keyword.iskeyword(name))\n\nclass _BoolOpToZ3(ast.NodeTransformer):\n    def visit_BoolOp(self, node):\n        self.generic_visit(node)\n        func_name = \"And\" if isinstance(node.op, ast.And) else \"Or\"\n        return ast.copy_location(ast.Call(func=ast.Name(id=func_name, ctx=ast.Load()), args=node.values, keywords=[]), node)\n    def visit_UnaryOp(self, node):\n        self.generic_visit(node)\n        if isinstance(node.op, ast.Not):\n            return ast.copy_location(ast.Call(func=ast.Name(id=\"Not\", ctx=ast.Load()), args=[node.operand], keywords=[]), node)\n        return node\n\ndef _compile_logic_expression(expression):\n    tree = ast.parse(expression, mode=\"eval\")\n    tree = _BoolOpToZ3().visit(tree)\n    ast.fix_missing_locations(tree)\n    return compile(tree, \"\u003cexpression\u003e\", \"eval\")\n\ndef _z3_type_from_name(type_name):\n    normalized = (type_name or \"Real\").strip().lower()\n    if normalized == \"bool\": return \"Bool\"\n    if normalized == \"int\": return \"Int\"\n    return \"Real\"\n\ndef _looks_boolean_context(expression, name):\n    if re.fullmatch(rf\"{re.escape(name)}\", expression.strip()): return True\n    logical_keywords = (\"And(\", \"Or(\", \"Not(\", \"Implies(\")\n    if any(k in expression for k in logical_keywords):\n        if re.search(rf\"\\b{name}\\b\", expression): return True\n    if re.search(rf\"\\b{name}\\b\\s*(==|!=)\\s*(True|False)\\b\", expression): return True\n    if re.search(rf\"\\b(True|False)\\b\\s*(==|!=)\\s*\\b{name}\\b\", expression): return True\n    return False\n\ndef _build_typed_z3_variables(expressions, vars=None):\n    variables = {}\n    declared = vars or {}\n    for expression in expressions:\n        for name in _extract_symbol_names(expression):\n            if name in _Z3_RESERVED_NAMES: continue\n            if name in variables: continue\n            type_name = declared.get(name, \"Real\")\n            if type_name == \"Real\" and _looks_boolean_context(expression, name):\n                type_name = \"Bool\"\n            sort = _z3_type_from_name(type_name)\n            if sort == \"Bool\": variables[name] = _z3.Bool(name)\n            elif sort == \"Int\": variables[name] = _z3.Int(name)\n            else: variables[name] = _z3.Real(name)\n    return variables\n\ndef _build_z3_eval_env(variables=None):\n    env = dict(_Z3_GLOBALS)\n    if variables: env.update(variables)\n    return env\n\ndef _normalize_claim_expression(expression):\n    normalized = expression.strip()\n    if (\"=\" in normalized and \"==\" not in normalized and \"!=\" not in normalized\n        and \"\u003c=\" not in normalized and \"\u003e=\" not in normalized):\n        left, right = normalized.split(\"=\", 1)\n        return f\"({left.strip()}) == ({right.strip()})\"\n    return normalized\n\npremises = [\"M == 3\",\"A == 1 or A == 2\",\"O == 1 or O == 2\",\"A != O\",\"O != 2\",\"A != 1\"]\nclaim = \"A == 2 and O == 1\"\nvars_ = {\"A\":\"Int\",\"M\":\"Int\",\"O\":\"Int\"}\n\nnormalized_premises = [_normalize_claim_expression(p) for p in premises]\nnormalized_claim = _normalize_claim_expression(claim)\nvariables = _build_typed_z3_variables([*normalized_premises, normalized_claim], vars=vars_)\neval_env = _build_z3_eval_env(variables)\nsolver = _z3.Solver()\n\ntry:\n    for p in normalized_premises:\n        compiled = _compile_logic_expression(p)\n        val = eval(compiled, {\"__builtins__\": {}}, eval_env)\n        print(\"premise\", p, \"-\u003e\", val)\n        solver.add(val)\n    compiled_claim = _compile_logic_expression(normalized_claim)\n    claim_val = eval(compiled_claim, {\"__builtins__\": {}}, eval_env)\n    print(\"claim val:\", claim_val, type(claim_val))\n    solver.add(_z3.Not(claim_val))\nexcept Exception as e:\n    print(\"EXCEPTION:\", repr(e))\n\nprint(solver.check())\nEOF\n"},"response":null}
