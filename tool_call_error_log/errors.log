ression): return True\n    if re.search(rf\"\\b{name}\\b\\s*(==|!=)\\s*(True|False)\\b\", expression): return True\n    if re.search(rf\"\\b(True|False)\\b\\s*(==|!=)\\s*\\b{name}\\b\", expression): return True\n    return False\n\ndef _build_typed_z3_variables(expressions, vars=None):\n    variables = {}\n    declared = vars or {}\n    for expression in expressions:\n        for name in _extract_symbol_names(expression):\n            if name in _Z3_RESERVED_NAMES: continue\n            if name in variables: continue\n            type_name = declared.get(name, \"Real\")\n            if type_name == \"Real\" and _looks_boolean_context(expression, name):\n                type_name = \"Bool\"\n            sort = _z3_type_from_name(type_name)\n            if sort == \"Bool\": variables[name] = _z3.Bool(name)\n            elif sort == \"Int\": variables[name] = _z3.Int(name)\n            else: variables[name] = _z3.Real(name)\n    return variables\n\ndef _build_z3_eval_env(variables=None):\n    env = dict(_Z3_GLOBALS)\n    if variables: env.update(variables)\n    return env\n\ndef _normalize_claim_expression(expression):\n    normalized = expression.strip()\n    if (\"=\" in normalized and \"==\" not in normalized and \"!=\" not in normalized\n        and \"\u003c=\" not in normalized and \"\u003e=\" not in normalized):\n        left, right = normalized.split(\"=\", 1)\n        return f\"({left.strip()}) == ({right.strip()})\"\n    return normalized\n\npremises = [\"M == 3\",\"A == 1 or A == 2\",\"O == 1 or O == 2\",\"A != O\",\"O != 2\",\"A != 1\"]\nclaim = \"A == 2 and O == 1\"\nvars_ = {\"A\":\"Int\",\"M\":\"Int\",\"O\":\"Int\"}\n\nnormalized_premises = [_normalize_claim_expression(p) for p in premises]\nnormalized_claim = _normalize_claim_expression(claim)\nvariables = _build_typed_z3_variables([*normalized_premises, normalized_claim], vars=vars_)\neval_env = _build_z3_eval_env(variables)\nsolver = _z3.Solver()\n\ntry:\n    for p in normalized_premises:\n        compiled = _compile_logic_expression(p)\n        val = eval(compiled, {\"__builtins__\": {}}, eval_env)\n        print(\"premise\", p, \"-\u003e\", val)\n        solver.add(val)\n    compiled_claim = _compile_logic_expression(normalized_claim)\n    claim_val = eval(compiled_claim, {\"__builtins__\": {}}, eval_env)\n    print(\"claim val:\", claim_val, type(claim_val))\n    solver.add(_z3.Not(claim_val))\nexcept Exception as e:\n    print(\"EXCEPTION:\", repr(e))\n\nprint(solver.check())\nEOF\n"},"response":null}
